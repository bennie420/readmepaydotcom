<svg xmlns="http://www.w3.org/2000/svg"
     width="500"
     height="110"
     viewBox="0 0 500 110"
     fill="none"
     role="img"
     aria-label="Error: {{ error_title }}">
  <defs>
    <linearGradient id="errorCardBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1c1917"/>
      <stop offset="100%" stop-color="#0c0a09"/>
    </linearGradient>
  </defs>

  <style>
    .base { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    .error-title { font-size: 14px; font-weight: 700; fill: #f85149; }
    .error-msg { font-size: 11px; font-weight: 400; fill: #8b949e; }
    .error-sub { font-size: 10px; font-weight: 500; fill: #6e7681; }
    .error-pill { font-size: 10px; font-weight: 700; fill: #f85149; letter-spacing: 0.5px; }
  </style>

  <!-- Outer Card Container -->
  <rect x="0.5" y="0.5" width="499" height="109" rx="8" fill="url(#errorCardBg)" stroke="#da3633" stroke-width="1" stroke-opacity="0.6"/>

  <g class="base" transform="translate(20, 20)">
    <!-- Warning Icon -->
    <g transform="translate(0, 8)">
      <circle cx="20" cy="20" r="18" fill="#da3633" fill-opacity="0.15" stroke="#f85149" stroke-width="1.5"/>
      <line x1="20" y1="12" x2="20" y2="22" stroke="#f85149" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="20" cy="27" r="1.5" fill="#f85149"/>
    </g>

    <!-- Error Content -->
    <g transform="translate(56, 4)">
      <!-- Error Status Badge -->
      <rect x="0" y="0" width="70" height="18" rx="4" fill="#3c1e1e"/>
      <text x="35" y="12" text-anchor="middle" class="error-pill">HTTP {{ error_code }}</text>

      <text x="80" y="14" class="error-title">{{ error_title }}</text>
      <text x="0" y="38" class="error-msg">{{ error_message }}</text>
      <text x="0" y="56" class="error-sub">Dynamic Badge Platform &#x2022; Real GitHub Metadata Only</text>
    </g>
  </g>
</svg>
