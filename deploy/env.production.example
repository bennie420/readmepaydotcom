# OpenSponsor Production Environment Configuration
# Copy to .env or set in your VPS environment

HOST=0.0.0.0
PORT=8080

# Base URL (e.g. https://badge.yourdomain.com or https://your-vps-ip.nip.io)
BASE_URL=https://badge.yourdomain.com

# Domain for Caddy automatic HTTPS certificates (e.g. badge.yourdomain.com or :80)
DOMAIN=badge.yourdomain.com

# Database URL (SQLite WAL on persistent volume or PostgreSQL)
DB_URL=sqlite:////data/badge_platform.db
# Or PostgreSQL:
# DB_URL=postgresql+psycopg2://user:password@host:5432/opensponsor

# Optional GitHub Token to increase rate limits to 5,000 req/hr
GITHUB_TOKEN=ghp_your_token_here

# Secret salt for SHA-256 client impression deduplication
SALT=os-production-secret-salt-2026-secure-random
